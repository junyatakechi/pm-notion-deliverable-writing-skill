# pm-notion-deliverable-writing-skill が使うNotionのデータベース。値はプロジェクトのフォルダ直下(起動フォルダ)の .env に書く(設計原則 §2-3)。
# 値はワークスペース固有なのでスキル内には書かない。
# data source ID は collection:// を付けない値だけを書く。
# DeliverableデータベースのURL
PM_DELIVERABLE_DB_URL=
# Deliverableデータベースのdata source ID。新しいページを作るときの parent
PM_DELIVERABLE_DATA_SOURCE_ID=
# 文書の変更履歴データベースのURL
PM_DOC_HISTORY_DB_URL=
# 文書の変更履歴データベースのdata source ID。行を足すときの parent
PM_DOC_HISTORY_DATA_SOURCE_ID=
